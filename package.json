{
  "name": "relay",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:customer-api": "tsc -p customer-api/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "customer-api": "tsx customer-api/server.ts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "eval": "node --env-file=.env.local --import tsx scripts/evaluate.ts",
    "probe:fallback": "node --env-file=.env.local --import tsx scripts/probe-fallback.ts",
    "format": "prettier --write app components lib workflows customer-api tests scripts docs README.md"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.113",
    "@ai-sdk/workflow": "^2.0.72",
    "ai": "^7.0.140",
    "next": "^16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "workflow": "^5.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
