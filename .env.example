# ---- Customer world (what stays) ------------------------------------------
# The Northstar telemetry API. Locally this is `npm run customer-api`.
# In production point it at the AWS Lambda function URL (see customer-api/README.md).
TELEMETRY_API_URL=http://127.0.0.1:4319
TELEMETRY_API_TOKEN=local-dev-token

# ---- Vercel AI Gateway -----------------------------------------------------
# On Vercel the Gateway authenticates with the project's OIDC token; locally set a key.
AI_GATEWAY_API_KEY=
# Primary model and ordered fallbacks (comma separated). See lib/config.ts.
AI_MODEL=openai/gpt-5.2
AI_FALLBACK_MODELS=anthropic/claude-sonnet-5,google/gemini-2.5-flash
# Optional provider routing for the "data stays on AWS" story, e.g. bedrock,anthropic
AI_PROVIDER_ORDER=
AI_PROVIDER_ONLY=

# ---- Access and demo controls ---------------------------------------------
# Reviewers enter this once to start investigations (24h cookie).
DEMO_ACCESS_CODE=choose-a-code-and-share-it-privately
SESSION_SECRET=replace-with-a-long-random-secret
# Exposes the "Test resilience" controls (fault injection, provider outage drill).
DEMO_CONTROLS=true

# ---- Persistence -----------------------------------------------------------
# Postgres connection string for the investigation index (Neon, Supabase, RDS).
# Leave empty locally to use a JSON file under .data/.
DATABASE_URL=
