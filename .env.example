# ---- Customer world (what stays) ------------------------------------------
# The Northstar telemetry API. Locally this is `npm run customer-api`.
# In production use the separate telemetry service base URL (Vercel or Lambda).
TELEMETRY_API_URL=http://127.0.0.1:4319
TELEMETRY_API_TOKEN=local-dev-token

# ---- Vercel AI Gateway -----------------------------------------------------
# On Vercel the Gateway authenticates with the project's OIDC token; locally set a key.
AI_GATEWAY_API_KEY=
# Primary model and ordered fallbacks (comma separated). See lib/config.ts.
AI_MODEL=openai/gpt-5.2
# Automatic fallback stays off until a candidate passes the report-quality gate.
AI_FALLBACK_MODELS=
# Optional provider routing; this does not guarantee a specific region, e.g. bedrock,anthropic
AI_PROVIDER_ORDER=
AI_PROVIDER_ONLY=

# ---- Access and demo controls ---------------------------------------------
# Reviewers enter this once to start investigations (24h cookie).
DEMO_ACCESS_CODE=choose-a-code-and-share-it-privately
SESSION_SECRET=replace-with-a-long-random-secret
# Exposes the "Test resilience" controls (fault injection, provider outage drill, redeploy hold).
DEMO_CONTROLS=true
# Seconds the redeploy drill holds a run; how long a mitigation proposal waits for an owner.
DEMO_PAUSE_SECONDS=30
APPROVAL_TIMEOUT=15m
# Models a reviewer may pick for side-by-side comparison (the primary is always allowed).
AI_COMPARISON_MODELS=google/gemini-2.5-flash

# ---- Persistence -----------------------------------------------------------
# Postgres connection string for the investigation index (Neon, Supabase, RDS).
# Leave empty locally to use a JSON file under .data/.
DATABASE_URL=
