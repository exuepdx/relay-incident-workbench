# Run npm run mock in a second terminal. These defaults are LOCAL ONLY.
TELEMETRY_API_URL=http://127.0.0.1:4319/api/telemetry
TELEMETRY_API_TOKEN=local-demo-token
# In production, set both above to the separately deployed mock and a random token.
# Vercel deployments can use AI Gateway OIDC. For local live AI, set a gateway key.
AI_GATEWAY_API_KEY=
AI_MODEL=openai/gpt-5.2
# Leave false until Gateway access and credits are verified.
ENABLE_LIVE_AI=false
SESSION_SECRET=replace-with-a-random-secret-before-production
DEMO_ACCESS_CODE=choose-a-reviewer-code-and-share-privately
